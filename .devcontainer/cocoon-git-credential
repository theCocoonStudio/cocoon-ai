#!/bin/bash
# git's credential helper for github.com: the App token from /run/cocoon/token (or GH_TOKEN),
# read at each call so the host's re-minted token is the one git pushes with. Only `get`
# answers; `store` and `erase` do nothing, since nothing is ever written. The username is
# GitHub's for App tokens, x-access-token. Set by entrypoint.sh as the global credential.helper.
set -euo pipefail
[ "${1:-}" = get ] || exit 0
token="${GH_TOKEN:-}"
[ -n "$token" ] || token="$(cat /run/cocoon/token 2>/dev/null || true)"
[ -n "$token" ] || exit 0
host=""
while IFS= read -r line; do
  [ -z "$line" ] && break
  case "$line" in host=*) host="${line#host=}" ;; esac
done
[ "$host" = github.com ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"
