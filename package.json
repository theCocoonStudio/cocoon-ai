{
  "name": "cocoon-ai",
  "version": "0.0.1",
  "description": "Components and utilities for the Cocoon creative tech studio site (React 19 + react-three-fiber).",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets": "npm run assets:icons && npm run assets:logo",
    "assets:icons": "node assets/icons/build.js",
    "assets:logo": "node assets/logo/build.js"
  },
  "peerDependencies": {
    "@pmndrs/assets": "^1.7.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "maath": "^0.10.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.184.0",
    "tunnel-rat": "^0.1.2"
  },
  "peerDependenciesMeta": {
    "@pmndrs/assets": {
      "optional": true
    },
    "@react-three/drei": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "@react-three/postprocessing": {
      "optional": true
    },
    "maath": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "tunnel-rat": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^9.39.5",
    "@pmndrs/assets": "^1.7.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/test-renderer": "^9.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fontkit": "^2.0.4",
    "globals": "^17.12.0",
    "maath": "^0.10.8",
    "prettier": "^3.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.184.0",
    "tunnel-rat": "^0.1.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
